{
  "name": "@wangxiaocuo/dsh-composer-prefill",
  "version": "0.3.0",
  "description": "Codex-style composer predictions for DeepSeek Harness: suggest the next user message after an assistant turn and fill the composer on Tab.",
  "license": "MIT",
  "author": "wangxiaocuo",
  "homepage": "https://github.com/wangxiaocuo/dsh-composer-prefill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxiaocuo/dsh-composer-prefill.git"
  },
  "bugs": {
    "url": "https://github.com/wangxiaocuo/dsh-composer-prefill/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13",
    "dsh": "^0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "composer",
    "prediction",
    "prefill",
    "ghost-text"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "prompt.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node test/run-unit.mjs",
    "test:coverage": "node test/run-unit.mjs --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95",
    "test:dom": "node --test test/client-dom.test.mjs",
    "test:smoke": "node test/smoke-host.mjs",
    "test:e2e": "node test/e2e-host.mjs && node test/e2e-browser.mjs",
    "test:e2e:host": "node test/e2e-host.mjs",
    "test:e2e:browser": "node test/e2e-browser.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "release:check": "node scripts/check-release.mjs",
    "verify": "npm run typecheck && npm test && npm run test:smoke && npm run pack:check",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "22.20.5",
    "jsdom": "^27.4.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3"
  }
}
